NODE_ENV=development
PORT=3002

## JWT
JWT_SECRET=change-me-please
JWT_EXPIRES_IN=24h
## Database
DB_TYPE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=password
DB_NAME=ecommerce_dapp
# Used for referral links (register?ref=...). Use your app domain (e.g. shoplife.biz).
FRONTEND_URL=https://shoplife.biz

# SMTP (Email) - for verification code
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASS=your-app-password
SMTP_FROM=noreply@example.com
BSC_NETWORK=mainnet
BSC_TESTNET_RPC=https://data-seed-prebsc-1-s1.binance.org:8545
BSC_MAINNET_RPC=https://bsc-dataseed.binance.org/
BLOCKCHAIN_PRIVATE_KEY=xxxxxxxxxxx
TOKEN_ADDRESS=0x55d398326f99059fF775485246999027B3197955
PRIVATE_KEY=xxxxxxxxxxxxxxxxx
# Commission Payout Contract
COMMISSION_PAYOUT_CONTRACT_ADDRESS=xxxxxxxx 

# Auto Payout Configuration
AUTO_PAYOUT_ENABLED=true
AUTO_PAYOUT_BATCH_SIZE=50
AUTO_PAYOUT_MIN_AMOUNT=0.0001  # Optional: minimum amount to include in batch

# Google Sheets Configuration
GOOGLE_SHEET_ID=xxxxxxxxxxxxxxxxxxxx
GOOGLE_SERVICE_ACCOUNT_EMAIL=xxxxxxxxxx@xxxxxxx.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY=

# QuickNode Webhook USDT Integration
QUICKNODE_RPC_URL=https://<your-node>.bsc.discover.quiknode.pro/<token>/
SYSTEM_USDT_RECEIVER_ADDRESS=0x0000000000000000000000000000000000000000
SYSTEM_PV_RECEIVER_ADDRESS=0x0000000000000000000000000000000000000000
USDT_CONTRACT_ADDRESS=0x55d398326f99059fF775485246999027B3197955
USDT_DECIMALS=18
QUICKNODE_WEBHOOK_SECRET=qn_secret_here